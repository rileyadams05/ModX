{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModX",
  "version": "0.1.0",
  "identifier": "app.modx.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ModX",
        "width": 1360,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "center": true
      },
      {
        "label": "process-list",
        "title": "Process List",
        "width": 370,
        "height": 470,
        "minWidth": 340,
        "minHeight": 430,
        "center": true,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
